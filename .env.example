# ============================================================================
# Copy this file to ".env" and fill in your own values:   cp .env.example .env
# NEVER commit the real .env file. It is listed in .gitignore.
# This project uses Stripe TEST MODE only.
# ============================================================================

# --- Server -----------------------------------------------------------------
PORT=3000

# --- Stripe (TEST MODE ONLY) -------------------------------------------------
# Stripe Dashboard (test mode) -> Developers -> API keys -> Secret key.
# Must start with sk_test_ (the server refuses to start with a live key).
STRIPE_SECRET_KEY=sk_test_replace_me

# Printed by "stripe listen --forward-to localhost:3000/webhook"
# as "Your webhook signing secret is whsec_...". Must start with whsec_.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- Logging ------------------------------------------------------------------
# Folder for the .jsonl log files (default: ./logs)
# LOG_DIR=./logs

# Customer e-mails are MASKED in logs by default (j***@example.com).
# Set to true ONLY if you really need the full address in the log file.
LOG_FULL_EMAIL=false

# --- Optional forwarding to an external API ------------------------------------
# The client has not provided an endpoint or schema yet, so forwarding is OFF.
FORWARD_ENABLED=false

# Full URL of the client's endpoint (fill in only when the client provides it)
FORWARD_URL=

# POST (default), PUT or PATCH
FORWARD_METHOD=POST

# Give up if the external API does not answer in this many milliseconds
FORWARD_TIMEOUT_MS=5000

# Optional authentication header required by the client's API.
# Example: FORWARD_AUTH_HEADER_NAME=Authorization  and  FORWARD_AUTH_HEADER_VALUE=Bearer abc123
FORWARD_AUTH_HEADER_NAME=
FORWARD_AUTH_HEADER_VALUE=

# Send the FULL customer e-mail to the external API? (default false = masked)
# Only enable after the client confirms they need it.
FORWARD_FULL_EMAIL=false
